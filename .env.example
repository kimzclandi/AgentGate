# Local development ONLY. Server refuses non-loopback binding in this mode.
AGENTGATE_DEV=1
AGENTGATE_ADDR=127.0.0.1:8080
AGENTGATE_DATA=data
# Production-mode identity integration (not a complete production deployment):
# AGENTGATE_DEV=0
# OIDC_ISSUER=https://your-identity-provider.example
# OIDC_CLIENT_ID=your-client-id
# Optional model adapter. Never commit real keys. Not used by mock API.
# MODEL_ENDPOINT=https://your-provider.example/v1/chat/completions
# MODEL_ALLOWED_HOST=your-provider.example
# MODEL_NAME=your-supported-model
# MODEL_API_KEY=
